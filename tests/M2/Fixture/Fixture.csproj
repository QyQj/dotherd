<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>m2-worker</ToolCommandName>
    <SelfContained>false</SelfContained>
    <PackageType Condition="'$(McpFile)' != ''">DotnetTool;McpServer</PackageType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None Include="$(AppFile)" Pack="true" PackagePath=".dotherd/app.json" Condition="'$(AppFile)' != ''" />
    <None Include="$(McpFile)" Pack="true" PackagePath=".mcp/server.json" Condition="'$(McpFile)' != ''" />
  </ItemGroup>
</Project>
